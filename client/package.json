{
  "name": "pig-music-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src tests e2e playwright.config.ts package.json tsconfig.json",
    "format:check": "prettier --check src tests e2e playwright.config.ts package.json tsconfig.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "0.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
